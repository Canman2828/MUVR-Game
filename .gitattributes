## Unity project .gitattributes
## Purpose: make this repo behave identically on macOS and Windows.
##  - Normalizes text line endings (no CRLF/LF churn or noisy diffs).
##  - Forces Unity's serialized YAML assets to LF and marks them for smart merge.
##  - Marks binary asset types as binary so Git never munges them.
##
## Git LFS is intentionally NOT enabled here: git-lfs is not installed on this
## machine. Binaries are committed normally for now. See the LFS section at the
## bottom for how to switch large binaries to LFS later.

# Auto-detect text files; store them as LF in the repository.
* text=auto

## ---- Source / config / text ----
*.cs             text diff=csharp
*.cginc          text
*.shader         text
*.compute        text
*.hlsl           text
*.json           text
*.md             text
*.txt            text
*.xml            text
*.csv            text
*.yml            text
*.yaml           text
*.uxml           text
*.uss            text
*.asmdef         text
*.asmref         text

# Shell scripts must stay LF; Windows batch files must stay CRLF.
*.sh             text eol=lf
*.bash           text eol=lf
*.bat            text eol=crlf
*.cmd            text eol=crlf

## ---- Unity serialized assets (YAML) ----
## Force LF (Unity defaults to "OS Native", which causes Mac/Windows churn) and
## use Unity's smart merge tool. `merge=unityyamlmerge` only takes effect if a
## teammate has configured it in their local git config; otherwise Git falls
## back to a normal merge, so this is safe to commit regardless.
*.unity          text eol=lf merge=unityyamlmerge
*.prefab         text eol=lf merge=unityyamlmerge
*.asset          text eol=lf merge=unityyamlmerge
*.meta           text eol=lf merge=unityyamlmerge
*.mat            text eol=lf merge=unityyamlmerge
*.anim           text eol=lf merge=unityyamlmerge
*.controller     text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.physicsMaterial2D text eol=lf merge=unityyamlmerge
*.playable       text eol=lf merge=unityyamlmerge
*.mask           text eol=lf merge=unityyamlmerge
*.brush          text eol=lf merge=unityyamlmerge
*.flare          text eol=lf merge=unityyamlmerge
*.fontsettings   text eol=lf merge=unityyamlmerge
*.guiskin        text eol=lf merge=unityyamlmerge
*.giparams       text eol=lf merge=unityyamlmerge
*.renderTexture  text eol=lf merge=unityyamlmerge
*.spriteatlas    text eol=lf merge=unityyamlmerge
*.terrainlayer   text eol=lf merge=unityyamlmerge
*.mixer          text eol=lf merge=unityyamlmerge
*.shadervariants text eol=lf merge=unityyamlmerge
*.preset         text eol=lf merge=unityyamlmerge
*.signal         text eol=lf merge=unityyamlmerge

